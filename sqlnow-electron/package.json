{
  "name": "sqlnow-desktop",
  "productName": "sqlnow",
  "version": "0.4.5",
  "description": "Local SQL viewer for files and databases, in a native window",
  "license": "MIT",
  "author": "David Raznick",
  "homepage": "https://github.com/kindly/sqlnow",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "SQLNOW_SMOKE=1 electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.kindly.sqlnow",
    "productName": "sqlnow",
    "artifactName": "sqlnow-desktop-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "icons/**"
    ],
    "extraResources": [
      {
        "from": "../target/release/sqlnow",
        "to": "sqlnow"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../README.md",
        "to": "README.md"
      },
      {
        "from": "../AGENTS.md",
        "to": "AGENTS.md"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "icons",
      "desktop": {
        "entry": {
          "GenericName": "SQL viewer",
          "Categories": "Development;Database;",
          "MimeType": "text/csv;application/vnd.apache.parquet;application/x-sqlite3;",
          "Keywords": "SQL;DuckDB;CSV;Parquet;query;"
        }
      }
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "icons/1024x1024.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/1024x1024.png"
    }
  },
  "allowScripts": {
    "electron@43.2.0": true
  }
}
